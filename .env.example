# ---- 飞书应用凭据（必填，见 README 平台配置步骤） ----
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=your_app_secret

# ---- 发送者白名单（强烈建议配置） ----
# 允许操控你电脑的飞书用户 open_id，逗号分隔。
# 留空时机器人拒绝执行任何指令，并会在你发第一条消息时告诉你 open_id 是什么。
ALLOWED_USERS=

# ---- Claude 行为（可选，按需修改） ----
# Claude 的工作目录（默认：机器人所在目录；运行中可用 /cwd 切换）
#WORK_DIR=D:\work\yourproject

# 无头模式权限模式：
#   acceptEdits       - 自动同意文件编辑，命令仍受设置里的白名单控制（默认，较安全）
#   bypassPermissions - 跳过所有权限检查，可执行任意命令（谨慎！白名单里的人=能完全操控你的电脑）
#CLAUDE_PERMISSION_MODE=acceptEdits

# 单次任务超时（秒，默认 600）
#CLAUDE_TIMEOUT=600

# 是否把 Claude 的工具调用（如 Bash 命令）实时转发到飞书（1=开 0=关，默认开）
#FORWARD_TOOLS=1

# 传给 claude 的额外参数（如 --allowedTools "Bash(git *)"）
#CLAUDE_EXTRA_ARGS=

# 权限确认卡片：等你在飞书上点按钮/回文字的上限秒数（默认 600，超时按拒绝处理）
#PERM_TIMEOUT_SECONDS=600

# 桌面事件推送的"免打扰"阈值：键鼠无活动超过该秒数（=人离开了）才推送到飞书。
# 人在电脑前使用时不打扰。设为 0 表示总是推送。默认 180。
#NOTIFY_IDLE_SECONDS=180

# claude 可执行文件路径（默认自动从 PATH 查找）
#CLAUDE_PATH=
