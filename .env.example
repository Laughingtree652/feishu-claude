# ---- 飞书应用凭据（必填，见 README 平台配置步骤） ----
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=your_app_secret

# ---- 发送者白名单（强烈建议配置） ----
# 允许操控你电脑的飞书用户 open_id，逗号分隔。
# 留空时机器人拒绝执行任何指令，并会在你发第一条消息时告诉你 open_id 是什么。
ALLOWED_USERS=

# ---- Claude 行为（可选，按需修改） ----
# Claude 的工作目录（默认：机器人所在目录；运行中可用 /cwd 切换）
#WORK_DIR=D:\work\yourproject

# 无头模式权限模式（全局默认；每个聊天可用 /mode 单独覆盖，互不影响）：
#   acceptEdits       - 自动同意文件编辑，命令仍受设置里的白名单控制（默认，较安全）
#   bypassPermissions - 跳过所有权限检查，可执行任意命令（谨慎！白名单里的人=能完全操控你的电脑）
#CLAUDE_PERMISSION_MODE=acceptEdits

# 单次任务超时（秒，默认 600）
#CLAUDE_TIMEOUT=600

# 是否把 Claude 的工具调用（如 Bash 命令）实时转发到飞书（1=开 0=关，默认开）
#FORWARD_TOOLS=1

# 传给 claude 的额外参数（如 --allowedTools "Bash(git *)"）
#CLAUDE_EXTRA_ARGS=

# 权限确认卡片：等你在飞书上点按钮/回文字的上限秒数
# 默认 0 = 不限时（与桌面终端一致：卡片一直等你，/stop 可中断任务）；
# 设为正数则超时按拒绝处理
#PERM_TIMEOUT_SECONDS=0

# 会话进程闲置回收：无消息/无输出超过该秒数后回收长驻 claude 进程（默认 900）。
# 上下文已存盘，之后再发消息会自动 --resume 续接，无感知。
#SESSION_IDLE_TIMEOUT=900

# 桌面事件推送的"免打扰"阈值：键鼠无活动超过该秒数（=人离开了）才推送到飞书。
# 人在电脑前使用时不打扰。设为 0 表示总是推送。默认 180。
#NOTIFY_IDLE_SECONDS=180

# claude 可执行文件路径（默认自动从 PATH 查找）
#CLAUDE_PATH=

# Git Bash 的 bash.exe 完整路径（默认自动从 git 安装位置推导，一般无需设置）。
# 用途：Windows 上非交互启动的 claude 默认拿到 PowerShell 工具，settings 里
# Bash(...) 白名单规则会全部不命中、命令频繁弹权限卡；机器人通过注入
# CLAUDE_CODE_GIT_BASH_PATH 让飞书端的 claude 与终端一样使用 Bash 工具。
# 仅当自动推导失败（启动日志提示未定位到 bash.exe）时才需手动指定。
#GIT_BASH_PATH=D:\tools\Git\bin\bash.exe

# 会话摘要用的模型（驻留进程闲置回收后，后台起小模型把会话压成一行、/sessions 列表展示）。
# 填你模型网关里的别名，默认 haiku。
#SUMMARY_MODEL=haiku
